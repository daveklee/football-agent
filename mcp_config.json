{
  "mcpServers": {
    "yahoo-fantasy": {
      "command": "/Users/daveklee/Documents/github/football-agent/venv/bin/python",
      "args": [
        "/Users/daveklee/Documents/github/football-agent/fantasy-football-mcp-public/fantasy_football_multi_league.py"
      ],
      "cwd": "${PWD}",
      "env": {
        "YAHOO_ACCESS_TOKEN": "${YAHOO_ACCESS_TOKEN}",
        "YAHOO_REFRESH_TOKEN": "${YAHOO_REFRESH_TOKEN}",
        "YAHOO_CONSUMER_KEY": "${YAHOO_CONSUMER_KEY}",
        "YAHOO_CONSUMER_SECRET": "${YAHOO_CONSUMER_SECRET}",
        "YAHOO_GUID": "${YAHOO_GUID}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        "${PWD}/browser_profile",
        "--timeout-navigation",
        "30000",
        "--timeout-action",
        "5000"
      ],
      "env": {}
    }
  }
}